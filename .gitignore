/target
*.db
*.xml

# Fingerprint caches. redb databases, written wherever --cache points;
# `--cache test` in the repo root once committed a 3.6MB one.
*.redb
/test

# Static FFmpeg + dav1d prefix built by scripts/build-ffmpeg-static.sh.
# Several hundred MB of archives, headers and upstream checkouts, all
# reproducible from the pinned versions in that script.
/ffmpeg-static

# Ignore local accuracy test file
/tests/local_accuracy_test.rs
# Benchmark harnesses are tracked; their outputs, the AN-era labels and tool
# dumps (paths into a private corpus), backups and the venv are not.
/benchmark/out/
/benchmark/corpus/out/
/benchmark/corpus/.venv/
/benchmark/tools/
/benchmark/labels.csv*
/benchmark/bench_report.html
/benchmark/**/*.bak
/benchmark/**/*.bak-*
__pycache__/
!/flatpak/*.metainfo.xml

# Flatpak builds (flatpak/): the build tree, builder's cache and a local repo.
/build-flatpak/
/.flatpak-builder/
/repo-flatpak/
