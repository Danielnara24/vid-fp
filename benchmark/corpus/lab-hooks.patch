+    /// This tolerance held to the same chance when it is one of `tries`
+    /// alternative ways a pair is measured: each distance moves in to the
+    /// largest one whose chance tail is `tries` times smaller, so the
+    /// alternatives together admit a chance match as rarely as one comparison
+    /// does at the uncorrected distance.
+    fn corrected(self, width: u32, tries: u32) -> Self {
+        if tries <= 1 || std::env::var("VIDFP_CORR").is_ok_and(|v| v == "off") {
+            return self;
+        }
+        let extra = (tries as f64).log10();
+        let pull = |d: u32| {
+            let need = chance_orders_of_magnitude_of(width, d) + extra;
+            (0..=d).rev().find(|&t| chance_orders_of_magnitude_of(width, t) >= need).unwrap_or(0)
+        };
+        let loose_only = std::env::var("VIDFP_CORR").is_ok_and(|v| v == "loose"); // LAB
+        let strict = if loose_only { self.strict } else { pull(self.strict) };
+        let loose = pull(self.loose).max(strict);
+        Tolerance { strict, loose, cap: self.cap.map(|_| (loose / 2).min(HASH_BITS)) }
+    }
 }
 
