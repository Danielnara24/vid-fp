+/// LAB (not for commit): per file, each sample's nearest look-alike inside its
+/// own video at least `sep` ms away, for several separations, as combined
+/// main + detail distance. Plus the wide tolerance at `d`.
+pub fn lab_self_dump(fps: &[VideoFingerprint], d: u32, path: &str) -> std::io::Result<()> {
+    use rayon::prelude::*;
+    let tol = Tolerance::wide(d);
+    let seps: [u32; 4] = [0, 10_000, 30_000, 120_000];
+    let lines: Vec<String> = fps
+        .par_iter()
+        .map(|fp| {
+            let n = fp.valid_hashes.len();
+            let has_detail = fp.detail_hashes.len() == n;
+            let span = {
+                let mut s: Vec<u32> = (0..n).map(|i| fp.valid_t_end[i] - fp.valid_t_start[i]).collect();
+                s.sort_unstable();
+                s.get(n / 2).copied().unwrap_or(0).max(ALIGNMENT_TOLERANCE_MS as u32)
+            };
+            let mut mins: Vec<[u32; 4]> = vec![[u32::MAX; 4]; n];
+            for i in 0..n {
+                for j in 0..n {
+                    if i == j {
+                        continue;
+                    }
+                    let dt = fp.valid_t_start[i].abs_diff(fp.valid_t_start[j]);
+                    let mut dist = (fp.valid_hashes[i] ^ fp.valid_hashes[j]).count_ones();
+                    if has_detail {
+                        dist += (fp.detail_hashes[i] ^ fp.detail_hashes[j]).count_ones();
+                    }
+                    for (k, &s) in seps.iter().enumerate() {
+                        let s = if k == 0 { span } else { s };
+                        if dt > s && dist < mins[i][k] {
+                            mins[i][k] = dist;
+                        }
+                    }
+                }
+            }
+            serde_json::json!({"path": fp.path, "t": fp.valid_t_start, "span": span, "min": mins}).to_string()
+        })
+        .collect();
+    let head = serde_json::json!({"strict": tol.strict, "loose": tol.loose}).to_string();
+    std::fs::write(path, format!("{head}\n{}", lines.join("\n")))
+}
+
+/// `fp` with its samples thinned to at most one per `ALIGNMENT_TOLERANCE_MS`:
+/// a sample that starts sooner than that after the last one kept is folded into
+/// it, its span added to the kept one's. The matcher cannot place a match more
+/// finely than that window, so samples denser than it add no timing, only more
+/// draws of each picture's hash noise -- more chances to land near some frame
+/// of an unrelated file. (LAB switch VIDFP_THIN.)
+pub(crate) fn thinned(fp: &VideoFingerprint) -> VideoFingerprint {
+    let n = fp.valid_hashes.len();
+    let step = ALIGNMENT_TOLERANCE_MS as u32;
+    let mut keep: Vec<u32> = Vec::with_capacity(n); // new index of each old sample, or u32::MAX
+    let mut new_of = vec![u32::MAX; n];
+    let mut out = VideoFingerprint {
+        valid_hashes: Vec::new(),
+        valid_t_start: Vec::new(),
+        valid_t_end: Vec::new(),
+        mirrored_hashes: Vec::new(),
+        detail_hashes: Vec::new(),
+        mirrored_detail_hashes: Vec::new(),
+        reframed: Vec::new(),
+        path: fp.path.clone(),
+        codec: fp.codec.clone(),
+        ..*fp
+    };
+    let has = |v: &Vec<u64>| v.len() == n;
+    for i in 0..n {
+        let s = fp.valid_t_start[i];
+        if let Some(&last) = keep.last() {
+            if s < fp.valid_t_start[last as usize] + step {
+                let k = out.valid_t_end.len() - 1;
+                out.valid_t_end[k] = out.valid_t_end[k].max(fp.valid_t_end[i]);
+                continue;
+            }
+        }
+        new_of[i] = out.valid_hashes.len() as u32;
+        keep.push(i as u32);
+        out.valid_hashes.push(fp.valid_hashes[i]);
+        out.valid_t_start.push(s);
+        out.valid_t_end.push(fp.valid_t_end[i]);
+        if has(&fp.mirrored_hashes) {
+            out.mirrored_hashes.push(fp.mirrored_hashes[i]);
+        }
+        if has(&fp.detail_hashes) {
+            out.detail_hashes.push(fp.detail_hashes[i]);
+        }
+        if has(&fp.mirrored_detail_hashes) {
+            out.mirrored_detail_hashes.push(fp.mirrored_detail_hashes[i]);
+        }
+    }
+    out.reframed = fp
+        .reframed
+        .iter()
+        .map(|r| {
+            let mut o = crate::fingerprint::Reframed::default();
+            for (&s, h) in r.samples.iter().zip(&r.hashes) {
+                if let Some(&ni) = new_of.get(s as usize) {
+                    if ni != u32::MAX {
+                        o.samples.push(ni);
+                        o.hashes.push(*h);
+                    }
+                }
+            }
+            o
+        })
+        .collect();
+    out
+}
+
+fn thin_on() -> bool {
+    std::env::var_os("VIDFP_THIN").is_some()
+}
